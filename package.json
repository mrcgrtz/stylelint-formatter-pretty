{
  "name": "stylelint-formatter-pretty",
  "version": "5.0.0",
  "description": "A pretty Stylelint formatter.",
  "license": "MIT",
  "repository": "github:mrcgrtz/stylelint-formatter-pretty",
  "funding": [
    {
      "type": "kofi",
      "url": "https://ko-fi.com/mrcgrtz"
    },
    {
      "type": "liberapay",
      "url": "https://liberapay.com/mrcgrtz/"
    }
  ],
  "author": "Marc Görtz <git@marcgoertz.de> (https://marcgoertz.de/)",
  "type": "module",
  "exports": "./index.js",
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "prepare": "husky",
    "test": "xo && node --test --experimental-test-coverage"
  },
  "files": [
    "index.js"
  ],
  "keywords": [
    "stylelint",
    "stylelint-formatter",
    "formatter",
    "reporter",
    "lint",
    "validate"
  ],
  "dependencies": {
    "log-symbols": "^7.0.0",
    "string-width": "^7.0.0",
    "supports-hyperlinks": "^4.4.0"
  },
  "devDependencies": {
    "husky": "^9.0.10",
    "lint-staged": "^17.0.7",
    "stylelint": "^18.1.0",
    "xo": "^5.0.1"
  },
  "peerDependencies": {
    "stylelint": ">=18.0.0"
  },
  "lint-staged": {
    "*.js": "xo --fix"
  },
  "xo": {
    "rules": {
      "unicorn/no-for-each": "off"
    }
  }
}
